{
  "name": "feedback-chat-twitch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "download-7tv-emotes": "node scripts/download-7tv-emotes.js",
    "download-badges": "node scripts/download-badges.js",
    "generate:og": "tsx --tsconfig tsconfig.app.json src/generate-og.ts",
    "generate:og:watch": "tsx watch --tsconfig tsconfig.app.json src/generate-og.ts",
    "build": "pnpm download-badges && pnpm download-7tv-emotes && tsc -b && vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:github": "oxlint --format=github",
    "postinstall": "pnpm download-badges && pnpm download-7tv-emotes",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "marked": "^18.0.9",
    "takumi-js": "^2.5.5",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@types/tmi.js": "^1.8.6",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.1",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "tsx": "^4.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.3.0"
}
